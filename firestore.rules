rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if true;
    }

    match /characters/{characterId} {
      allow read, write: if true;
    }

    match /meta/{documentId} {
      allow read, write: if true;
    }
  }
}
